# ==============================================================================
# MindFlow 环境变量配置示例
# 使用说明：复制此文件为 .env.local，然后填入你的真实密钥
# 注意：.env.local 已在 .gitignore 中，切勿提交到代码仓库
# ==============================================================================

# DeepSeek API 密钥（用于对话教练 AI 功能）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Supabase 项目 URL
# 获取地址：https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Supabase Anon Key（公开匿名密钥，前端安全使用）
# 获取地址：同上，在 Project API keys 中选择 anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key（仅后端 API Routes 使用，绝对不要暴露到前端！）
# 获取地址：同上，在 Project API keys 中选择 service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
